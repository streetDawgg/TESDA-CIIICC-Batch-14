package Activities.Task1;

public class Task1 {
        String greet;
    Task1(String greet){
            this.greet = greet;
        }
   public static void main(String[] args) {
        Task1 Eng = new Task1("Hello World");
        Task1 Fil = new Task1("Kamusta Mundo");
        Task1 Due = new Task1("Guten Tag, Hallo");

        System.out.println(Eng.greet);
        System.out.println(Fil.greet);
        System.out.println(Due.greet);
    }
}